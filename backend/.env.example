# Copy to .env and edit. Never commit the real .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cp_judge_db"

# Signing key for access tokens. Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15

# The administrator, seeded at startup and not modifiable through the API.
# All three are required. ADMIN_EMAIL must be a normal address; the login
# schema validates it and reserved domains such as .local are rejected.
ADMIN_EMAIL=""
ADMIN_HANDLE=""
ADMIN_PASSWORD=""

PROBLEMS_DIR=engine/problems
JUDGE_PATH=engine/judge.py
ENGINE_TIMEOUT=300
